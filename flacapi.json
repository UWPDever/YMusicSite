{
  "version": 5,
  "versionName": "5.0.0",
  "updatedAt": "2026-11-26",
  "description": "FLAC/Hi-Res lossless streaming resolver configuration with array-ordered streamResolvers prioritizing arcod.xyz",
  "streamResolvers": [
    {
      "id": "arcod-quality",
      "name": "Arcod Player Stream API (Specified Quality)",
      "enabled": true,
      "priority": 1,
      "urlTemplate": "https://arcod.xyz/api/player/stream/{track_id}?quality={quality}",
      "method": "GET",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        "Accept": "application/json, text/plain, */*"
      },
      "responseType": "json",
      "urlJsonPath": "url|data.url|stream_url|download_url",
      "fileSizeJsonPath": "size|file_size|length|data.size",
      "mimeTypeJsonPath": "mimeType",
      "qualityJsonPath": "quality",
      "timeoutMs": 8000,
      "requireProbe": true
    },
    {
      "id": "arcod-default",
      "name": "Arcod Player Stream API (Default)",
      "enabled": true,
      "priority": 2,
      "urlTemplate": "https://arcod.xyz/api/player/stream/{track_id}",
      "method": "GET",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        "Accept": "application/json, text/plain, */*"
      },
      "responseType": "json",
      "urlJsonPath": "url|data.url|stream_url|download_url",
      "fileSizeJsonPath": "size|file_size|length|data.size",
      "mimeTypeJsonPath": "mimeType",
      "qualityJsonPath": "quality",
      "timeoutMs": 8000,
      "requireProbe": true
    }
  ]
}
